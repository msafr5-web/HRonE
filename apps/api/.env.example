# Copy to .env — never commit real secrets.
NODE_ENV=development
PORT=4000
# Local embedded DB (npm run dev:db) uses this URL:
DATABASE_URL=postgresql://hrone:hrone@localhost:54329/HRoeN
WEB_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Seed admin (used by `npm run db:seed`)
ADMIN_EMAIL=admin@hrone.local
ADMIN_PASSWORD=ChangeMe-Admin-123

# Billing webhook (provider-agnostic HMAC-SHA256). Provider choice is still open.
WEBHOOK_SECRET=change-me-webhook-secret-at-least-16

# Outgoing email (password reset + email verification). Get these from your mail host for hrone.online.
# Leave SMTP_HOST empty to disable mail (links are then only logged in development).
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=hrone@hrone.online
SMTP_PASS=
MAIL_FROM="HRonE <hrone@hrone.online>"
