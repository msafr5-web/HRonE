# Copy to .env.production (never commit it) and fill in every value.
DOMAIN=hrone.online

# Strong random values:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
WEBHOOK_SECRET=

# Mail (hrone@hrone.online) – from your mail host
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hrone@hrone.online
SMTP_PASS=
MAIL_FROM="HRonE <hrone@hrone.online>"

# First admin (used once by the seed)
ADMIN_EMAIL=
